{
  "name": "online-judge",
  "version": "1.0.0",
  "private": true,
  "description": "A small online judge: Express API, Redis queue, Docker-sandboxed worker, Postgres, React UI",
  "workspaces": [
    "shared",
    "express-server",
    "worker",
    "web"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema shared/prisma/schema.prisma",
    "dev:api": "tsx express-server/src/index.ts",
    "dev:worker": "tsx worker/src/index.ts",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "db:migrate": "prisma migrate deploy --schema shared/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema shared/prisma/schema.prisma",
    "judge:pull-images": "node scripts/pull-images.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "~5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
