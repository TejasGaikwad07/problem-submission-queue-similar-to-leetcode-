# Copy to .env (never commit .env). Defaults match docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/judge"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Used only by `npm test`. The tests TRUNCATE tables: use a throwaway database.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/judge_test"
# Optional: enables the Redis queue test
# REDIS_URL_TEST="redis://localhost:6379"

# Optional overrides for the sandbox (defaults shown)
# JUDGE_IMAGE_CPP=gcc:13
# JUDGE_IMAGE_JAVASCRIPT=node:20-alpine
# JUDGE_IMAGE_PYTHON=python:3.12-alpine
# JUDGE_MEMORY=256m
# JUDGE_CPUS=1
# JUDGE_PIDS_LIMIT=64
# JUDGE_OUTPUT_LIMIT_BYTES=65536
# JUDGE_STARTUP_ALLOWANCE_MS=2000
